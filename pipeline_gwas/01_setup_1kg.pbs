#!/bin/bash
#PBS -N 01-setup-1kg
#PBS -e 01-setup-1kg.err
#PBS -o 01-setup-1kg.log
#PBS -q workq

cd "$PBS_O_WORKDIR"
export MAMBA_ROOT_PREFIX=/storage2/matheusbomfim/projects/micromamba
echo "=========================================="
echo "1000 Genomes hg38 Setup Job"
echo "Start time: $(date)"
echo "Working directory: $(pwd)"
echo "=========================================="
/storage2/matheusbomfim/projects/micromamba/bin/micromamba run -n quali bash 01_setup_1kg.sh
EXIT_CODE=$?
echo "=========================================="
if [ $EXIT_CODE -eq 0 ]; then
    echo "SUCCESS: Setup completed at $(date)"
else
    echo "FAILURE: Setup exited with code $EXIT_CODE at $(date)"
fi
echo "=========================================="
