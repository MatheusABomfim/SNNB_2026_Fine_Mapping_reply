#!/bin/bash
#PBS -N 05-analise-ancestralidade
#PBS -e 05-analise-ancestralidade.err
#PBS -o 05-analise-ancestralidade.log
#PBS -q workq

cd "$PBS_O_WORKDIR"
export MAMBA_ROOT_PREFIX=/storage2/matheusbomfim/projects/micromamba

echo "=========================================="
echo "05_analise_ancestralidade.R (consistencia por populacao)"
echo "  input : resultados/tabelas/lookup_completo.csv"
echo "Start time: $(date)"
echo "Working directory: $(pwd)"
echo "=========================================="

/storage2/matheusbomfim/projects/micromamba/bin/micromamba run -n quali Rscript 05_analise_ancestralidade.R

EXIT_CODE=$?
echo "=========================================="
if [ $EXIT_CODE -eq 0 ]; then
    echo "SUCCESS: 05_analise_ancestralidade.R completed at $(date)"
else
    echo "FAILURE: 05_analise_ancestralidade.R exited with code $EXIT_CODE at $(date)"
fi
echo "=========================================="
