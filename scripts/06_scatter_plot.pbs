#!/bin/bash
#PBS -N 06-scatter-plot
#PBS -e scripts/06-scatter-plot.err
#PBS -o scripts/06-scatter-plot.log
#PBS -q workq

cd "$PBS_O_WORKDIR"
export MAMBA_ROOT_PREFIX=/storage2/matheusbomfim/projects/micromamba

echo "=========================================="
echo "06_scatter_plot.R (scatter direcao do efeito MVP x exoma)"
echo "  input : resultados/tabelas/lookup_completo.csv"
echo "Start time: $(date)"
echo "Working directory: $(pwd)"
echo "=========================================="

/storage2/matheusbomfim/projects/micromamba/bin/micromamba run -n quali Rscript scripts/06_scatter_plot.R

EXIT_CODE=$?
echo "=========================================="
if [ $EXIT_CODE -eq 0 ]; then
    echo "SUCCESS: 06_scatter_plot.R completed at $(date)"
else
    echo "FAILURE: 06_scatter_plot.R exited with code $EXIT_CODE at $(date)"
fi
echo "=========================================="
